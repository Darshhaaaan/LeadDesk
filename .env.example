# Environment configuration template
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# development | test | production
NODE_ENV=development

# Backend HTTP port
PORT=3001

# PostgreSQL (Neon, Supabase, RDS, or local Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# JWT signing secret (at least 32 characters; use a long random value in production)
JWT_SECRET=change-me-use-a-long-random-string-in-production

# JWT lifetime (e.g. 15m, 30m, 1h, 7d)
JWT_EXPIRES_IN=15m

# Public frontend origin. Used for CORS and all absolute links in emails.
FRONTEND_URL=http://localhost:5173

# Public backend origin
BACKEND_URL=http://localhost:3001

# Cookie names (defaults are shown)
AUTH_COOKIE_NAME=auth_token
CSRF_COOKIE_NAME=csrf_token

# Branding and support contact used by transactional emails
APP_NAME=LeadDesk
# Required in production; optional in development
# SUPPORT_EMAIL=support@example.com
SUPPORT_EMAIL=

# SMTP / transactional email provider (optional in development/test)
# Set SMTP_HOST, SMTP_USER, SMTP_PASS, and SMTP_FROM together.
# When unset in development, emails are captured in the in-memory outbox.
# Example values:
#   SMTP_HOST=smtp.example.com
#   SMTP_USER=user@example.com
#   SMTP_PASS=password
#   SMTP_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (usually port 465); false/omit for STARTTLS (usually port 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional Reply-To address; defaults to SUPPORT_EMAIL
SMTP_REPLY_TO=

# Logging level hint for deployment platforms
LOG_LEVEL=info

# Frontend (Vite) configuration.
# Leave VITE_API_BASE_URL blank for same-origin requests through the Vite dev proxy.
# For a separately hosted API, set it to the backend origin with its scheme,
# e.g. https://leadapp-api.onrender.com. It must be present at build time;
# changing it in Vercel requires a new deployment.
VITE_API_BASE_URL=
# Dev proxy target used by `npm run dev:client`
VITE_DEV_API_TARGET=http://localhost:3001
