    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
