{
  "name": "task",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run typecheck && npm run typecheck:client && vite build --config client/vite.config.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:client": "tsc -p client/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
